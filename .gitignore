# Secrets & local config
.env
.env.local
*.local

# Copyrighted / private game data — never commit (see plan: gitignored official JSON)
/data/official/

# Go
/bin/
/backend/server
/backend/bin/
*.test
*.out

# Node / frontend
node_modules/
/frontend/dist/
/frontend/node_modules/
/frontend/.vite/
*.log
npm-debug.log*

# Embedded build output (generated; the real SPA build is copied in at build time)
/backend/internal/static/assets/*
!/backend/internal/static/assets/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local test assets (maps upload into the app; never commit them)
/assets/

# Database dumps written by the prod backup service
/backups/

.claude/settings.local.json

# Playwright (issue #105) — reports and traces are per-run artifacts.
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.cache/
/server.log

# Exploratory QA runs (xq- specs) — screenshots and per-run outputs.
/frontend/exp-shots/
/frontend/exp-results/
/frontend/e2e/xq-*.png
