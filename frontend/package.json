{
  "name": "questboard-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen:bundle": "node scripts/bundle-spec.mjs",
    "gen:api": "openapi-typescript ../openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "openapi-fetch": "^0.17.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "15.5.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "js-yaml": "5.2.3",
    "openapi-typescript": "^7.4.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
