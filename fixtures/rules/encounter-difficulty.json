{
  "_note": [
    "The 2024 encounter maths (#110), implemented twice: frontend/src/lib/",
    "encounterDifficulty.ts for the builder's meter, backend/internal/rules/",
    "encounter.go for the MCP server's encounter_check (#318). This file keeps",
    "them honest — both test suites read it, and neither may drift alone.",
    "",
    "xp: a creature's data in, its XP out. The creature's own cr string wins",
    "over the CR table; a lair's second number is ignored; crValue is only the",
    "fallback for homebrew that states no XP.",
    "budgets: party levels in, the summed per-character budget out; levels off",
    "the end of the table clamp to it.",
    "bands: a total against a party's levels; the bands are floors."
  ],
  "xp": [
    { "name": "XP after", "data": { "cr": "1/4 (XP 50; PB +2)", "crValue": 0.25 }, "xp": 50 },
    { "name": "XP before", "data": { "cr": "3 (700 XP; PB +2)", "crValue": 3 }, "xp": 700 },
    { "name": "lair ignored", "data": { "cr": "17 (XP 18,000, or 20,000 in lair; PB +6)", "crValue": 17 }, "xp": 18000 },
    { "name": "creature over table", "data": { "cr": "12 (XP 8,000; PB +4)", "crValue": 12 }, "xp": 8000 },
    { "name": "worthless CR 0", "data": { "cr": "0 (XP 0; PB +2)", "crValue": 0 }, "xp": 0 },
    { "name": "CR only", "data": { "cr": "5", "crValue": 5 }, "xp": 1800 },
    { "name": "crValue only", "data": { "crValue": 0.25 }, "xp": 50 },
    { "name": "nothing", "data": {}, "xp": 0 }
  ],
  "budgets": [
