    { "levels": [3, 3, 3], "budget": { "low": 450, "moderate": 675, "high": 1200 } },
    { "levels": [], "budget": { "low": 0, "moderate": 0, "high": 0 } },
    { "levels": [0], "budget": { "low": 50, "moderate": 75, "high": 100 } },
    { "levels": [99], "budget": { "low": 6400, "moderate": 13200, "high": 22000 } }
  ],
  "bands": [
    { "levels": [5, 5, 5, 5], "xp": 1999, "band": "trivial" },
    { "levels": [5, 5, 5, 5], "xp": 2000, "band": "low" },
    { "levels": [5, 5, 5, 5], "xp": 2999, "band": "low" },
    { "levels": [5, 5, 5, 5], "xp": 3000, "band": "moderate" },
    { "levels": [5, 5, 5, 5], "xp": 4400, "band": "high" },
    { "levels": [5, 5, 5, 5], "xp": 999999, "band": "high" },
